# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
db.sqlite3
media/
*.log
staticfiles/

# Secrets / environment (never commit real values; .env.example IS committed)
.env
*.env
!.env.example
local_settings.py

# Local IDE Brains & Model Context (kept local, not shared with the repo)
.ai/


# Coverage artifacts (B-03)
.coverage
coverage_report.txt

# Private notes & local archives (kept local, never committed to git)
docs/PRIVATE_*
*.private.*
*.bak
*.zip
backups/
*.sql.gz
scratch/

# Generated by apps/core/services/asset_bundles.py at app start.
# Deleting them is safe - they are rewritten byte-identical on the next boot.
/static/css/classstamp.bundle.css
/static/js/classstamp.core.bundle.js
