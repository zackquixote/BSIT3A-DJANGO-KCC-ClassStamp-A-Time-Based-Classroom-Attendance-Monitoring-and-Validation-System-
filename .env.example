# Copy this file to `.env` (which is git-ignored) and fill in real values.
#   cp .env.example .env
#
# Loaded automatically by mysite/settings/base.py via python-dotenv.

# 'development' or 'production'. Only affects which settings module is loaded.
DJANGO_ENV=development

# REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated list of host/domain names this site may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL connection (matches a local XAMPP setup by default).
DB_NAME=bsitcrud
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Production-only toggles (ignored in development).
# Set to False locally if you serve over plain HTTP behind a proxy.
DJANGO_SECURE_SSL_REDIRECT=True
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.edu.ph

# Shared cache for anti-replay + scan throttling. Leave blank in development
# (in-process cache). In production point this at a shared backend and run
# `python manage.py createcachetable` once:
#   DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
#   DJANGO_CACHE_LOCATION=classstamp_cache
DJANGO_CACHE_BACKEND=
DJANGO_CACHE_LOCATION=classstamp_cache

# ── Outbound email (password reset links) ─────────────────────────────────────
# Leave DJANGO_EMAIL_BACKEND blank in development to print mail to the console.
# To deliver for real through Gmail:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password (Google Account → Security → App passwords).
#   3. Fill the block below. The password is 16 characters, shown once.
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=classstamp.kcc@gmail.com
#   EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# Gmail rewrites From: unless it matches the authenticated account, so keep
# DEFAULT_FROM_EMAIL the same address as EMAIL_HOST_USER.
# DEFAULT_FROM_EMAIL=classstamp.kcc@gmail.com
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
